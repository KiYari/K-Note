<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create_profile_table" author="termrdz@gmail.com">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="profile"/>
            </not>
        </preConditions>

        <createTable tableName="profile">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create_profile_oauth_table" author="termrdz@gmail.com">
        <validCheckSum>ANY</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="profile_oauth"/>
            </not>
        </preConditions>

        <createTable tableName="profile_oauth">
            <column name="person_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="oauth" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="profile_oauth"
                                 baseColumnNames="person_id"
                                 constraintName="fk_profile_oauth_profile"
                                 referencedTableName="PROFILE"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>